{
  // Standalone keep-warm Worker — deliberately separate from the Expo app and
  // its Vercel web build. See src/index.ts for why.
  //
  // Deploy from this directory:  npm run deploy
  "name": "pocketquartermaster-keepwarm",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-03",

  // No HTTP surface: this Worker is reachable only by its cron trigger.
  //
  // Both of these default to TRUE when absent, which would publish a public
  // *.workers.dev address and a preview URL (this happened on the sibling
  // RoundtableAttendance Worker). Nothing would leak — with no fetch() handler
  // every request just returns error 1101 — but a scheduled job has no business having a public
  // endpoint, and each probe of it burns free-plan request quota. Setting them
  // explicitly is also self-documenting: a reader can see the omission was a
  // decision rather than an oversight.
  "workers_dev": false,
  "preview_urls": false,

  // Three pings a day, eight hours apart.
  //
  // WHY three and not one: Supabase's own wording is "a few user requests to
  // the database each day over the previous week". One ping a day would meet
  // that only if every single one succeeds — a transient network blip would
  // leave a full 24-hour hole in the record. Three costs nothing (cron
  // invocations are free on the Workers plan) and means two consecutive
  // failures still leave the day covered.
  //
  // WHY UTC IS FINE HERE, despite this project's local-time rule: that rule
  // exists because a user-perceived moment shown in the wrong timezone reads as
  // the app being broken. Nobody perceives these pings — nothing is displayed,
  // nothing is stored, no date is derived. All that matters is that they are
  // spread across the day, and UTC spreads them exactly as well as any other
  // zone. Do not "fix" this to America/Denver; there is nothing to fix.
  // BEFORE YOU DEBUG A CRON THAT "ISN'T FIRING": WAIT LONGER. Cloudflare's docs
  // say trigger changes take "up to 15 minutes" to propagate. Measured on the
  // RoundtableAttendance Worker (2026-09-03), a new trigger took ~89 MINUTES to fire for the first
  // time (deployed 18:09 UTC, first firing 19:38 UTC) — and then ran exactly on
  // schedule, every slot, with no gaps. We concluded it was broken at the
  // 63-minute mark and deleted a trigger that was about to start working.
  //
  // So: after changing this, give it at least two hours of silence before
  // suspecting a fault, and judge by the healthchecks.io ping list rather than
  // `wrangler tail` — tail is built around fetch events and did not surface a
  // single one of the 28 scheduled invocations we later confirmed had run.
  "triggers": {
    "crons": ["0 2,10,18 * * *"]
  },

  // Logs are the backstop if the dead-man's switch is misconfigured: the
  // dashboard keeps the cron invocation history and anything console.log'd.
  "observability": {
    "enabled": true
  }

  // No "vars" block on purpose. SUPABASE_URL, SUPABASE_ANON_KEY and
  // HEALTHCHECK_URL are all set as secrets (see README.md). The first two are
  // not really secret — the anon key ships in the browser bundle — but keeping
  // them out of the repo matches how the app itself handles them (.env.local /
  // EAS env / Vercel settings), and this repo is public.
}
