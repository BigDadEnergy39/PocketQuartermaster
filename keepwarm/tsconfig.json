{
  // Standalone from the site's tsconfig on purpose: this code runs in the
  // Cloudflare Workers runtime, not a browser, so it needs the Workers globals
  // (ScheduledController, ExportedHandler) and none of the DOM ones.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
