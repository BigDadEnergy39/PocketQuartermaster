{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // WHY this restates Expo's base list: "exclude" replaces the inherited one
  // rather than merging with it. keepwarm/ is the addition — it targets the
  // Cloudflare Workers runtime and type-checks under its own tsconfig.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "keepwarm"
  ]
}
